{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stet-room-test",
  "main": "dist/ai_chat/index.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ai-chat-room-test", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REALTIME", "class_name": "FreebuffRealtime", "script_name": "freebuff-sites-realtime-local" }
    ]
  },
  "observability": { "enabled": true }
}
