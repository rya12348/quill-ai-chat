    "db:prune": "node scripts/prune-data.mjs",
    "pages:secrets": "node scripts/sync-pages-secrets.mjs",
    "load:test": "node scripts/load-test.mjs",
    "preview": "vite preview",
    "retro": "node scripts/retro-host.mjs",
    "coding-lab": "node scripts/coding-lab.test.mjs",
    "bench:repo": "tsx scripts/buffy-repo-benchmark.ts",
    "test": "tsx --test scripts/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codebuff/sdk": "0.10.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@freebuff/auth": "^0.1.0",
    "@tanstack/react-query": "^5.104.0",
    "docx": "^9.15.3",
    "hono": "^4.13.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.60.0",
    "mammoth": "^1.13.0",
    "motion": "^14.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.0",
    "@tailwindcss/vite": "^4.3.0",
