# Copy to .env. Wrangler reads .env and .env.local for local development;
# both are git-ignored. On Freebuff Sites, set OPENAI_API_KEY in Sites → Secrets.

# Optional: the app answers from a built-in local reply until this is set.
# Your Freebuff API key (fb_live_…). Create one at https://freebuff.com/account/api
# — in Freebuff Desktop, Account → Developer API can write it here for you.
OPENAI_API_KEY=

# Optional. Defaults to the Freebuff API.
# OPENAI_BASE_URL=https://freebuff.com/api/v1/paid

# Optional: a free Pollinations key (https://enter.pollinations.ai) upgrades the
# keyless GPT-OSS 20B lane to Kimi K3. Visitors never need a key either way.
# POLLINATIONS_API_KEY=
# Optional: any model id the Pollinations key can reach.
# PUBLIC_AI_MODEL=moonshotai/kimi-k3

# Optional: a free Groq key (https://console.groq.com) adds GPT-OSS 120B as a
# hosted lane. Visitors never need a key either way.
# GROQ_API_KEY=gsk_…
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: an OpenRouter key (https://openrouter.ai/keys) adds free models as
# hosted lanes. OPENROUTER_MODELS is a comma-separated list.
# OPENROUTER_API_KEY=sk-or-v1-…
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-super-vl:free

# Optional: a Mistral key (https://console.mistral.ai) adds its free-tier models
# as hosted lanes.
# MISTRAL_API_KEY=…
# MISTRAL_MODEL=mistral-large-4

# Optional: a free NVIDIA NIM key (https://build.nvidia.com) adds DeepSeek V4.1
# Flash, GLM-5.3 Flash, Nemotron 3 Ultra, GPT-OSS 20B and Gemma 4 (free at up to
# 40 requests a minute). NVIDIA_MODEL puts one preferred model first.
# NVIDIA_API_KEY=nvapi-…
# NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash

# Optional: a free Ollama Cloud key (https://ollama.com/settings/keys, no card)
# adds DeepSeek V4 Pro, Kimi K3, GLM-5.3, MiniMax M3 and DeepSeek V4 Flash
# while its monthly starter credits last. OLLAMA_MODEL sets a preferred model.
# OLLAMA_API_KEY=…
# OLLAMA_MODEL=deepseek-v4-pro:0813

# Optional: local Ollama (https://ollama.com). Set the OpenAI-compatible URL
# and a comma-separated model list. This works only while Quill and Ollama run
# on the same computer; a deployed Worker cannot reach your machine.
# OLLAMA_LOCAL_URL=http://127.0.0.1:11434/v1/chat/completions
# OLLAMA_LOCAL_MODELS=qwen2.5-coder:3b,qwen2.5-coder:7b

# Optional: a SambaNova Cloud key (https://cloud.sambanova.ai) adds DeepSeek
# V3.2/V3.1, GPT-OSS 120B and MiniMax M2.7. The free tier is capped at 20
# requests/day and 200K tokens/day per model.
# SAMBANOVA_API_KEY=…
# SAMBANOVA_MODEL=DeepSeek-V3.2

# Optional: a free LLM7 token (https://dash.llm7.io/#/api-keys) raises the rate
# limit on LLM7's free "turbo" models: GPT-OSS 20B, Codestral and Mistral Nemo.
# The pro ids (DeepSeek V4, Kimi K3, GLM-5.3) need a paid plan and are not in
# Quill's free chain.
# LLM7_API_KEY=…

# Optional: a free ModelScope token (https://modelscope.cn) adds its hosted
# DeepSeek V4.1 Flash.
# MODELSCOPE_API_KEY=…
# MODELSCOPE_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Optional: a Cohere API key (https://cohere.com) adds Command A+ through the
# OpenAI-compatible endpoint. Trial keys use limited trial credits, not
# unlimited free usage. COHERE_MODEL overrides the model.
# COHERE_API_KEY=…
# COHERE_MODEL=command-a-plus-05-2026

# Optional: a free Google AI Studio key (https://aistudio.google.com/apikey)
# adds Gemini 3.8 Flash, the strongest free Gemini lane. GEMINI_MODEL overrides it.
# GEMINI_API_KEY=…
# GEMINI_MODEL=gemini-3.8-flash

# Optional: a free Z.ai key (https://z.ai) adds GLM-4.5 Flash. Newer GLM
# models need paid credits; ZAI_MODEL overrides the model.
# ZAI_API_KEY=…
# ZAI_MODEL=glm-4.5-flash

# Optional: Cloudflare Workers AI uses the free daily neuron allowance. Create a
# token with Workers AI access and set the account id. Override the model with
# CLOUDFLARE_AI_MODEL.
# CLOUDFLARE_ACCOUNT_ID=…
# CLOUDFLARE_AI_TOKEN=…
# CLOUDFLARE_AI_MODEL=@cf/openai/gpt-oss-120b

# Optional: an Exa key (https://exa.ai) upgrades web grounding. Without it the
# app uses keyless Wikipedia, DuckDuckGo, Stack Exchange, Hacker News and news
# sources. Free monthly credits, no card.
# EXA_API_KEY=…

# Optional: pin owner-only perks to one signed-in Freebuff account by its sub.
# On localhost without sign-in, the development user already counts as owner.
# OWNER_SUB=

# Optional: real Sign in with Freebuff on localhost, from sites_enable_auth's
# development variables. Without them a local development user is used.
# FREEBUFF_CLIENT_ID=
# FREEBUFF_ISSUER=https://freebuff.com/oidc
# APP_ORIGIN=http://localhost:5173

# Enables the free-only Research mode (off by default).
# RESEARCH_ENABLED=1

# Enables the free-only Analyze mode (off by default).
# ANALYZE_ENABLED=1

# Enables the free-only Build mode (off by default).
# BUILD_ENABLED=1
